@model IReadOnlyList<AdminWalletRow>
@{ ViewData["Title"] = "Quản lý ví"; var withdrawals = (IReadOnlyList<AdminWithdrawalRow>)ViewBag.Withdrawals; var candidates = (IReadOnlyList<SellerPayoutCandidate>)ViewBag.Candidates; }
<div class="eyebrow mt-4">CoCo Backoffice</div><h1 class="page-title mt-1">Ví ký gửi</h1>
<p class="subtitle">Đối chiếu số dư, giao dịch và yêu cầu rút. Chỉ đơn đã thanh toán và hoàn tất mới được ghi có ví người bán.</p>
<h2 class="display-serif fs-4 mt-4">Tiền bán hàng chờ ghi có</h2>
<div class="row g-3 mb-4">
@foreach (var candidate in candidates)
{
    <div class="col-12 col-lg-6"><div class="panel h-100">
        <div class="eyebrow">@candidate.ProductSku · @candidate.SellerName</div>
        <div class="spec-row"><span>Tiền hàng</span><strong>@candidate.MerchandiseAmount.ToString("N0") đ</strong></div>
        <div class="spec-row"><span>Hoa hồng CoCo</span><strong>@candidate.CommissionAmount.ToString("N0") đ</strong></div>
        <div class="spec-row"><span>Ghi có người bán</span><strong>@candidate.NetAmount.ToString("N0") đ</strong></div>
        <form asp-action="Credit" method="post" class="mt-3"><input type="hidden" name="orderId" value="@candidate.OrderId" />
            <div class="form-check mb-2"><input class="form-check-input" type="checkbox" name="confirmed" value="true" id="credit-@candidate.OrderId" required />
                <label class="form-check-label" for="credit-@candidate.OrderId">Đã đối soát đơn hoàn tất và thanh toán.</label></div>
            <button class="btn btn-wine btn-sm" type="submit">Ghi có ví</button></form>
    </div></div>
}
@if (candidates.Count == 0) { <div class="col-12"><p class="text-muted">Không có đơn chờ ghi có.</p></div> }
</div>
<div class="panel table-responsive mb-4"><table class="table align-middle mb-0"><thead><tr><th>Chủ ví</th><th>Email</th><th>Số dư</th><th>Giao dịch</th><th></th></tr></thead><tbody>
@foreach (var w in Model)
{ <tr><td>@w.OwnerName</td><td>@w.OwnerEmail</td><td>@w.Balance.ToString("N0") đ</td><td>@w.TransactionCount</td><td><a asp-action="Details" asp-route-id="@w.Id">Xem</a></td></tr> }
</tbody></table>@if (Model.Count == 0) { <p class="text-muted my-3">Chưa có ví.</p> }</div>
<h2 class="display-serif fs-4">Yêu cầu rút tiền</h2>
<div class="panel table-responsive mb-5"><table class="table align-middle mb-0"><thead><tr><th>Người dùng</th><th>Số tiền</th><th>Tài khoản</th><th>Trạng thái</th><th>Xử lý</th></tr></thead><tbody>
@foreach (var r in withdrawals)
{ <tr><td>@r.OwnerName</td><td>@r.Amount.ToString("N0") đ</td><td>@r.BankAccountMasked</td><td>@r.Status</td>
    <td>@if (r.Status == "Pending")
        {
            <form asp-action="DecideWithdrawal" method="post" class="d-flex flex-wrap gap-2">
                <input type="hidden" name="id" value="@r.Id" />
                <button class="btn btn-sm btn-wine" name="approve" value="true" type="submit">Duyệt</button>
                <input class="form-control form-control-sm" style="max-width:180px" name="reason" placeholder="Lý do từ chối" />
                <button class="btn btn-sm btn-outline-danger" name="approve" value="false" type="submit">Từ chối</button>
            </form>
        }
        else if (r.Status == "Approved") { <span class="small text-muted">Chờ chuyển khoản thực tế</span> }
    </td></tr> }
</tbody></table>@if (withdrawals.Count == 0) { <p class="text-muted my-3">Chưa có yêu cầu.</p> }</div>
