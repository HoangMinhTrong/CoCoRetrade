@model IReadOnlyList<AuditEntry>
@{ ViewData["Title"] = "Nhật ký kiểm định"; }
<div class="eyebrow mt-4">CoCo Backoffice</div><h1 class="page-title mt-1">Nhật ký kiểm định</h1>
<form method="get" class="panel d-flex flex-column flex-sm-row gap-2 mb-4"><input class="form-control" name="productId" type="text" value="@ViewBag.ProductId" placeholder="Product ID (không bắt buộc)" /><button class="btn btn-wine">Lọc</button></form>
<div class="panel table-responsive mb-5"><table class="table align-middle mb-0"><thead><tr><th>Thời gian UTC</th><th>Hành động</th><th>Người thực hiện</th><th>Sản phẩm</th><th>Chi tiết</th></tr></thead><tbody>
@foreach (var item in Model)
{ <tr><td>@item.CreatedAtUtc.ToString("dd/MM/yyyy HH:mm")</td><td>@item.Action</td><td>@item.ActorId</td><td>@item.EntityId</td><td>@item.Details</td></tr> }
</tbody></table>@if (Model.Count == 0) { <p class="text-muted my-3">Chưa có sự kiện.</p> }</div>
