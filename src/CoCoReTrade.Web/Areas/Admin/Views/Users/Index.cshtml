@model IReadOnlyList<AdminUserRow>
@{ ViewData["Title"] = "Quản lý người dùng"; }
<div class="eyebrow mt-4">CoCo Backoffice</div><h1 class="page-title mt-1">Người dùng & quyền kiểm định</h1>
<p class="subtitle">Quyền đăng bán được cấp riêng cho từng kiểm định viên. Thay đổi quyền yêu cầu đăng nhập lại.</p>
<form method="get" class="panel d-flex flex-column flex-sm-row gap-2 mb-4"><input class="form-control" type="search" name="search" value="@ViewBag.Search" placeholder="Tên, email hoặc số điện thoại" /><button class="btn btn-wine">Tìm</button></form>
<div class="row g-3 mb-5">
@foreach (var user in Model)
{
    <div class="col-12 col-xl-6"><div class="panel h-100">
        <h2 class="fs-5">@user.FullName</h2><div class="small text-muted">@user.Email · @user.Phone</div>
        <div class="mt-2"><span class="badge bg-secondary">@(user.IsAdmin ? "Admin" : user.IsInspector ? "Inspector" : "User")</span> <span class="badge bg-info text-dark">Tín nhiệm: @user.TrustScore/100</span>
        @if (user.TrustSuspended) { <span class="badge bg-danger">Tạm khóa theo điểm</span> }
        @if (user.IsLocked) { <span class="badge bg-danger">Đã khóa</span> }
        @if (user.HasDirectPublishGrant) { <span class="badge bg-success">Products.Publish</span> }</div>
        @if (!user.IsAdmin && user.Id != User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value)
        {
            <div class="d-flex flex-wrap gap-2 mt-3">
                <form asp-action="Inspector" method="post"><input type="hidden" name="id" value="@user.Id" /><input type="hidden" name="enabled" value="@(!user.IsInspector)" /><button class="btn btn-sm btn-outline-wine">@(user.IsInspector ? "Thu hồi Inspector" : "Cấp Inspector")</button></form>
                @if (user.IsInspector)
                { <form asp-action="PublishGrant" method="post"><input type="hidden" name="id" value="@user.Id" /><input type="hidden" name="enabled" value="@(!user.HasDirectPublishGrant)" /><button class="btn btn-sm btn-outline-wine">@(user.HasDirectPublishGrant ? "Thu hồi Publish" : "Cấp Publish")</button></form> }
                <form asp-action="Lock" method="post"><input type="hidden" name="id" value="@user.Id" /><input type="hidden" name="locked" value="@(!user.IsLocked)" /><button class="btn btn-sm @(user.IsLocked ? "btn-outline-success" : "btn-outline-danger")">@(user.IsLocked ? "Mở khóa" : "Khóa tài khoản")</button></form>
            </div>
            <form asp-action="Trust" method="post" class="row g-2 mt-2"><input type="hidden" name="id" value="@user.Id" /><div class="col-3"><input class="form-control form-control-sm" type="number" name="score" min="0" max="100" value="@user.TrustScore" aria-label="Điểm tín nhiệm" required /></div><div class="col-6"><input class="form-control form-control-sm" name="reason" placeholder="Lý do điều chỉnh" minlength="5" maxlength="500" required /></div><div class="col-3"><button class="btn btn-outline-wine btn-sm w-100" type="submit">Lưu điểm</button></div></form>
        }
    </div></div>
}
</div>
