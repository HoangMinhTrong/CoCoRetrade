@model IReadOnlyList<SupportTicketRow>
@{ ViewData["Title"] = "Yêu cầu hỗ trợ"; }
<div class="eyebrow mt-4">Quản trị CoCo</div><h1 class="page-title mt-1">Yêu cầu hỗ trợ</h1>
@if (Model.Count == 0) { <div class="empty-state mt-4">Chưa có yêu cầu hỗ trợ.</div> }
else { <div class="row g-2 mb-5">@foreach (var ticket in Model) { <div class="col-12"><a class="panel d-flex justify-content-between gap-3 text-decoration-none" asp-action="Details" asp-route-id="@ticket.Id"><span><strong>@ticket.Subject</strong><br /><small>@ticket.UserName · @ticket.LastActivityAtUtc.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</small></span><span>@(ticket.Status == SupportTicketStatus.Open ? "Đang xử lý" : "Đã đóng")</span></a></div> }</div> }
