@model IReadOnlyList<AdminProductItem>
@{ ViewData["Title"] = "Ký gửi chờ kiểm định"; }
<div class="d-flex flex-wrap justify-content-between align-items-end gap-3 mt-4 mb-3">
    <div><div class="eyebrow">CoCo ReTrade</div><h1 class="page-title mt-1 mb-0">Ký gửi chờ duyệt</h1></div>
    <a class="btn btn-outline-wine" asp-area="Admin" asp-controller="Dashboard" asp-action="Index">Tổng quan</a>
</div>
<p class="subtitle">Kiểm tra hiện vật và ghi kết quả. Bài chỉ lên sàn sau khi người có quyền Publish xác nhận.</p>
<form method="get" class="panel mb-4 d-flex flex-column flex-sm-row gap-2">
    <input class="form-control" type="search" name="search" value="@ViewBag.Search" placeholder="Mã ký gửi, SKU, tên món hoặc người bán" aria-label="Tìm ký gửi" />
    <button class="btn btn-wine" type="submit">Tìm kiếm</button>
</form>
@if (Model.Count == 0)
{
    <div class="empty-state"><h2 class="display-serif fs-4">Không có món chờ duyệt</h2><p>Danh sách sẽ cập nhật khi có đơn ký gửi mới.</p></div>
}
else
{
    <div class="row g-3 mb-5">
    @foreach (var p in Model)
    {
        <div class="col-12 col-md-6 col-xl-4"><article class="panel h-100">
            <div class="eyebrow">@p.ConsignmentCode</div>
            <h2 class="fs-5 mt-2">@p.Name</h2>
            <div class="text-muted small mb-2">@p.Brand · @p.SellerName</div>
            @if (!string.IsNullOrEmpty(p.Sku)) { <div class="small">SKU: <strong>@p.Sku</strong></div> }
            <div class="mt-3"><a class="btn btn-wine btn-sm" asp-action="Review" asp-route-id="@p.Id">Mở phiếu kiểm định</a></div>
        </article></div>
    }
    </div>
}
