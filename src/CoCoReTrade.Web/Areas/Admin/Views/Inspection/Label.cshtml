@model AdminProductDetails
@{ Layout = null; }
<!doctype html><html lang="vi"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/>
<title>Tem @Model.Product.Sku</title><style>
body{font-family:Arial,sans-serif;margin:24px;color:#222}.label{width:80mm;min-height:58mm;border:1px solid #aaa;padding:5mm;box-sizing:border-box}
.brand{font-weight:800;letter-spacing:2px}.sku{font-size:18px;font-weight:800;margin:9px 0;word-break:break-all}.muted{font-size:11px;color:#555}
.codes{display:flex;gap:4mm;align-items:center;margin:3mm 0}.qr{width:22mm;height:22mm;flex:none}.qr svg{width:100%;height:100%}
button{margin-top:20px;padding:10px 18px;cursor:pointer}@@media print{body{margin:0}button{display:none}.label{border:0}}
</style></head><body><div class="label"><div class="brand">CoCo RETRADE</div>
<div class="codes"><div class="qr">@Html.Raw(SkuQrCode.Svg(Model.Product.Sku))</div><div class="sku">@Model.Product.Sku</div></div>
<div>@Model.Product.Name · @Model.Product.Brand · @Model.Product.Size</div><div class="muted">Mã ký gửi @Model.Product.ConsignmentCode</div></div>
<button onclick="window.print()">In tem</button></body></html>
