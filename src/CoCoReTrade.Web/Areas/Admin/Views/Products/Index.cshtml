@model IReadOnlyList<AdminProductItem>
@{ ViewData["Title"] = "Quản lý sản phẩm"; }
<header class="admin-page-header"><div><div class="eyebrow">Danh mục cửa hàng</div><h1 class="page-title">Sản phẩm</h1><p class="subtitle mb-0">Tra cứu ký gửi và theo dõi từng sản phẩm từ lúc tiếp nhận đến khi bán.</p></div><span class="admin-status">@Model.Count kết quả</span></header>
<form method="get" class="panel admin-toolbar mb-4">
    <div class="flex-grow-1"><label class="form-label" for="productSearch">Tìm sản phẩm</label><input class="form-control" type="search" id="productSearch" name="search" value="@ViewBag.Search" placeholder="Mã chờ duyệt, SKU, tên hoặc người bán" /></div>
    <div><label class="form-label" for="productStatus">Trạng thái</label><select class="form-select" id="productStatus" name="status"><option value="">Tất cả trạng thái</option>
        @foreach (var status in Enum.GetValues<ProductStatus>())
        { <option value="@status" selected="@(ViewBag.Status?.ToString() == status.ToString())">@UiText.For(status)</option> }
    </select></div>
    <button class="btn btn-wine" type="submit"><svg class="icon" aria-hidden="true"><use href="/images/icons.svg#filter" /></svg> Áp dụng</button>
    @if (!string.IsNullOrWhiteSpace((string?)ViewBag.Search) || ViewBag.Status is not null) { <a class="btn btn-outline-wine" asp-action="Index">Xóa lọc</a> }
</form>
<div class="panel mb-5">
@if (Model.Count == 0)
{
    <div class="empty-state border-0"><h2 class="fs-4">Không có sản phẩm phù hợp</h2><p class="mb-0">Thử từ khóa khác hoặc chọn tất cả trạng thái.</p></div>
}
else
{
    <div class="table-responsive"><table class="table admin-table align-middle mb-0"><caption class="visually-hidden">Danh sách sản phẩm và trạng thái ký gửi</caption><thead><tr><th scope="col">Sản phẩm</th><th scope="col">Mã chờ duyệt</th><th scope="col">SKU chính thức</th><th scope="col">Người ký gửi</th><th scope="col">Trạng thái</th><th scope="col"><span class="visually-hidden">Thao tác</span></th></tr></thead><tbody>
    @foreach (var p in Model)
    {
        <tr><td><strong>@p.Name</strong><div class="small text-muted">@p.Brand</div></td><td><span class="admin-code">@p.ConsignmentCode</span></td><td><span class="admin-code">@(string.IsNullOrEmpty(p.Sku) ? "Chưa cấp" : p.Sku)</span></td><td>@p.SellerName</td><td><span class="admin-status @(p.Status == ProductStatus.Active || p.Status == ProductStatus.Sold ? "admin-status--success" : p.Status == ProductStatus.PendingApproval ? "admin-status--warning" : "admin-status--muted")">@UiText.For(p.Status)</span></td>
            <td class="text-end"><a class="btn btn-outline-wine btn-sm text-nowrap" asp-area="Admin" asp-controller="Inspection" asp-action="@(p.Status == ProductStatus.PendingApproval ? "Review" : "Details")" asp-route-id="@p.Id">@(p.Status == ProductStatus.PendingApproval ? "Kiểm định" : "Chi tiết") <span aria-hidden="true">→</span></a></td></tr>
    }
    </tbody></table></div>
}
</div>
