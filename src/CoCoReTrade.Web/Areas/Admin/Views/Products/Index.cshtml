@model IReadOnlyList<AdminProductItem>
@{ ViewData["Title"] = "Quản lý sản phẩm"; }
<div class="eyebrow mt-4">CoCo Backoffice</div><h1 class="page-title mt-1">Sản phẩm</h1>
<form method="get" class="panel d-flex flex-column flex-sm-row gap-2 mb-4">
    <input class="form-control" type="search" name="search" value="@ViewBag.Search" placeholder="Mã, SKU, tên hoặc người bán" />
    <select class="form-select" name="status" aria-label="Trạng thái"><option value="">Tất cả trạng thái</option>
        @foreach (var status in Enum.GetValues<ProductStatus>())
        { <option value="@status" selected="@(ViewBag.Status?.ToString() == status.ToString())">@status</option> }
    </select><button class="btn btn-wine" type="submit">Lọc</button>
</form>
<div class="panel mb-5 table-responsive"><table class="table align-middle mb-0"><thead><tr><th>Mã ký gửi</th><th>SKU</th><th>Sản phẩm</th><th>Người bán</th><th>Trạng thái</th><th></th></tr></thead><tbody>
@foreach (var p in Model)
{
    <tr><td>@p.ConsignmentCode</td><td>@(string.IsNullOrEmpty(p.Sku) ? "—" : p.Sku)</td><td>@p.Name</td><td>@p.SellerName</td><td>@p.Status</td>
        <td><a asp-area="Admin" asp-controller="Inspection" asp-action="@(p.Status == ProductStatus.PendingApproval ? "Review" : "Details")" asp-route-id="@p.Id">@((p.Status == ProductStatus.PendingApproval) ? "Kiểm định" : "Chi tiết")</a></td></tr>
}
</tbody></table>@if (Model.Count == 0) { <p class="text-muted my-3">Không có sản phẩm phù hợp.</p> }</div>
