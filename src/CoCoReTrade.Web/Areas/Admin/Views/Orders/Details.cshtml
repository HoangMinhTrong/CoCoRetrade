@model OrderDto
@inject ShippingPolicy Shipping
@{ ViewData["Title"] = "Đơn " + Model.ProductSku;
   var pickupAtStore = Model.PickupAtUtc.HasValue ? new DateTimeOffset(Model.PickupAtUtc.Value, TimeSpan.Zero).ToOffset(TimeSpan.FromHours(Shipping.StoreUtcOffsetHours)).ToString("dd/MM/yyyy HH:mm") : null; }
<div class="mt-4"><a asp-action="Index">← Danh sách đơn</a></div>
<div class="row g-4 mt-1 mb-5"><div class="col-lg-7"><div class="panel">
    <div class="eyebrow">@Model.ProductSku</div><h1 class="page-title mt-2">@Model.ProductName</h1>
    <p><span class="status-pill">@Model.Status</span> <span class="status-pill">Thanh toán: @Model.PaymentStatus</span></p>
    <div class="spec-row"><span>Người nhận</span><strong>@Model.RecipientName · @Model.RecipientPhone</strong></div>
    <div class="spec-row"><span>Hình thức</span><strong>@Model.Fulfillment</strong></div>
    @if (Model.Fulfillment == FulfillmentType.Pickup) { <div class="spec-row"><span>Giờ lấy</span><strong>@pickupAtStore</strong></div><div class="spec-row"><span>Địa chỉ CoCo khi đặt</span><strong>@Model.PickupAddress</strong></div> }
    else { <div class="spec-row"><span>Giao tới</span><strong>@Model.StreetAddress, @Model.Ward, @Model.Province</strong></div>
        @if (Model.PreferredDeliveryWindow.HasValue) { <div class="spec-row"><span>Khung giờ thuận tiện</span><strong>@Model.PreferredDeliveryWindow</strong></div> }
        @if (!string.IsNullOrWhiteSpace(Model.DeliveryNote)) { <div class="spec-row"><span>Ghi chú cho người giao</span><strong>@Model.DeliveryNote</strong></div> }
    }
    <div class="spec-row"><span>Tiền hàng</span><strong>@Model.MerchandisePrice.ToString("N0")đ</strong></div>
    <div class="spec-row"><span>Phí giao</span><strong>@Model.ShippingFee.ToString("N0")đ</strong></div>
    <div class="spec-row"><span>Tổng</span><strong>@Model.TotalAmount.ToString("N0")đ</strong></div>
    <div class="spec-row"><span>Hoa hồng CoCo</span><strong>@Model.CommissionAmount.ToString("N0")đ</strong></div>
    <p class="small text-muted mt-3 mb-0">Đơn mới chưa được coi là đã thanh toán. Xác nhận thanh toán chỉ sau khi CoCo thực sự nhận tiền. Ví người bán chưa được ghi có tự động.</p>
</div></div><div class="col-lg-5"><div class="panel"><h2 class="display-serif fs-4">Xử lý đơn</h2>
    @if (Model.Status == OrderStatus.PendingProcessing) { <form asp-action="Ready" asp-route-id="@Model.Id" method="post" class="mb-2"><button class="btn btn-wine w-100">@(Model.Fulfillment == FulfillmentType.Pickup ? "Sẵn sàng tại cửa hàng" : "Bàn giao vận chuyển")</button></form> }
    @if (Model.PaymentStatus == PaymentStatus.Unpaid && Model.Status is not (OrderStatus.Cancelled or OrderStatus.Completed))
    { <form asp-action="ConfirmPayment" asp-route-id="@Model.Id" method="post" class="mb-3"><label class="form-label" for="reference">Mã biên nhận / giao dịch thực tế</label><input class="form-control mb-2" id="reference" name="reference" required minlength="4" maxlength="100" /><button class="btn btn-outline-wine w-100">Xác nhận đã nhận tiền</button></form> }
    @if (Model.PaymentStatus == PaymentStatus.Paid && Model.Status is OrderStatus.ReadyForPickup or OrderStatus.Shipping)
    { <form asp-action="Complete" asp-route-id="@Model.Id" method="post" class="mb-2"><button class="btn btn-wine w-100">Hoàn tất · đánh dấu đã bán</button></form> }
    @if (Model.PaymentStatus == PaymentStatus.Unpaid && Model.Status is OrderStatus.PendingProcessing or OrderStatus.ReadyForPickup)
    { <form asp-action="Cancel" asp-route-id="@Model.Id" method="post"><button class="btn btn-outline-danger w-100">Hủy và mở bán lại</button></form> }
</div></div></div>
