@model OrderDto
@inject ShippingPolicy Shipping
@{ ViewData["Title"] = "Đơn " + Model.ProductSku;
   var pickupAtStore = Model.PickupAtUtc.HasValue ? new DateTimeOffset(Model.PickupAtUtc.Value, TimeSpan.Zero).ToOffset(TimeSpan.FromHours(Shipping.StoreUtcOffsetHours)).ToString("dd/MM/yyyy HH:mm") : null; }
<div class="mt-4"><a asp-action="Index">← Danh sách đơn</a></div>
<div class="row g-4 mt-1 mb-5"><div class="col-lg-7"><div class="panel">
    <div class="eyebrow">@Model.ProductSku</div><h1 class="page-title mt-2">@Model.ProductName</h1>
    <p><span class="status-pill">@(Model.Status == OrderStatus.Completed ? Model.Fulfillment == FulfillmentType.Shipping ? "Giao hàng thành công" : "Đã nhận tại CoCo" : UiText.For(Model.Status))</span> <span class="status-pill">Thanh toán: @UiText.For(Model.PaymentStatus)</span></p>
    <div class="spec-row"><span>Người nhận</span><strong>@Model.RecipientName · @Model.RecipientPhone</strong></div>
    <div class="spec-row"><span>Hình thức</span><strong>@UiText.For(Model.Fulfillment)</strong></div>
    @if (Model.Fulfillment == FulfillmentType.Pickup) { <div class="spec-row"><span>Giờ lấy</span><strong>@pickupAtStore</strong></div><div class="spec-row"><span>Địa chỉ CoCo khi đặt</span><strong>@Model.PickupAddress</strong></div>
        @if (Model.PickupDeadlineAtUtc.HasValue) { <div class="alert alert-warning mt-3">Đơn dùng giá thỏa thuận: phải nhận trước @(new DateTimeOffset(Model.PickupDeadlineAtUtc.Value, TimeSpan.Zero).ToOffset(TimeSpan.FromHours(Shipping.StoreUtcOffsetHours)).ToString("dd/MM/yyyy HH:mm")) (giờ CoCo). Nếu không đến và chưa thanh toán, hệ thống hủy đơn và mở bán lại theo giá gốc.</div> }
    }
    else { <div class="spec-row"><span>Giao tới</span><strong>@Model.StreetAddress, @Model.Ward, @Model.Province</strong></div>
        @if (Model.PreferredDeliveryWindow.HasValue) { <div class="spec-row"><span>Khung giờ thuận tiện</span><strong>@Model.PreferredDeliveryWindow</strong></div> }
        @if (!string.IsNullOrWhiteSpace(Model.DeliveryNote)) { <div class="spec-row"><span>Ghi chú cho người giao</span><strong>@Model.DeliveryNote</strong></div> }
    }
    <div class="spec-row"><span>Tiền hàng</span><strong>@Model.MerchandisePrice.ToString("N0") VNĐ</strong></div>
    <div class="spec-row"><span>Phí giao</span><strong>@Model.ShippingFee.ToString("N0") VNĐ</strong></div>
    <div class="spec-row"><span>Tổng</span><strong>@Model.TotalAmount.ToString("N0") VNĐ</strong></div>
    <div class="spec-row"><span>Hoa hồng CoCo</span><strong>@Model.CommissionAmount.ToString("N0") VNĐ</strong></div>
    <p class="small text-muted mt-3 mb-0">Đơn mới chưa được coi là đã thanh toán. Chỉ xác nhận thanh toán khi CoCo thực sự nhận tiền, sau đó đánh dấu giao/nhận thành công. Tiền hàng trừ hoa hồng sẽ được ghi có vào ví người ký gửi cùng lúc hoàn tất đơn.</p>
</div></div><div class="col-lg-5"><div class="panel"><h2 class="display-serif fs-4">Xử lý đơn</h2>
    @if (Model.Status == OrderStatus.PendingProcessing) { <form asp-action="Ready" asp-route-id="@Model.Id" method="post" class="mb-2"><button class="btn btn-wine w-100">@(Model.Fulfillment == FulfillmentType.Pickup ? "Sẵn sàng tại cửa hàng" : "Bàn giao vận chuyển")</button></form> }
    @if (Model.PaymentStatus == PaymentStatus.Unpaid && Model.Status is OrderStatus.ReadyForPickup or OrderStatus.Shipping)
    { <form asp-action="ConfirmPayment" asp-route-id="@Model.Id" method="post" class="mb-3"><label class="form-label" for="reference">Mã biên nhận / giao dịch thực tế</label><input class="form-control mb-2" id="reference" name="reference" required minlength="4" maxlength="100" /><button class="btn btn-outline-wine w-100">Xác nhận đã nhận tiền</button></form> }
    @if (Model.PaymentStatus == PaymentStatus.Paid && Model.Status is OrderStatus.ReadyForPickup or OrderStatus.Shipping)
    { <form asp-action="Complete" asp-route-id="@Model.Id" method="post" class="mb-2"><button class="btn btn-wine w-100">@(Model.Fulfillment == FulfillmentType.Pickup ? "Khách đã nhận tại CoCo · hoàn tất & ghi có ví" : "Giao hàng thành công · hoàn tất & ghi có ví")</button></form> }
    @if (Model.PaymentStatus == PaymentStatus.Unpaid && Model.Status is OrderStatus.PendingProcessing or OrderStatus.ReadyForPickup)
    { <form asp-action="Cancel" asp-route-id="@Model.Id" method="post"><button class="btn btn-outline-danger w-100">Hủy và mở bán lại</button></form> }
    @if (Model.PaymentStatus == PaymentStatus.Unpaid && Model.Status == OrderStatus.Shipping)
    { <form asp-action="ReturnUndelivered" asp-route-id="@Model.Id" method="post" class="mt-3 border-top pt-3">
        <p class="small">Khách không nhận hàng: chỉ mở bán lại sau khi món đồ thực tế đã quay về CoCo. Phí một chiều được xử lý theo chính sách vận chuyển riêng.</p>
        <div class="form-check mb-2"><input class="form-check-input" type="checkbox" id="itemReturnedToStore" name="itemReturnedToStore" value="true" required /><label class="form-check-label" for="itemReturnedToStore">Tôi xác nhận món đồ đã về CoCo</label></div>
        <button class="btn btn-outline-danger w-100" type="submit">Ghi nhận không nhận hàng · mở bán lại</button>
    </form> }
</div></div></div>
