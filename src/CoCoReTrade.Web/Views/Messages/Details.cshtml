@model ConversationDetails
@{ ViewData["Title"] = "Tin nhắn về " + Model.Summary.ProductName; var myId = User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value; }
<div class="mt-4 mb-3"><a asp-action="Index">← Tất cả tin nhắn</a></div>
<div class="eyebrow">@Model.Summary.ProductSku · @Model.Summary.OtherUserName</div><h1 class="page-title mt-1">@Model.Summary.ProductName</h1>
<p id="connection-status" class="small text-muted" role="status" aria-live="polite">Tin nhắn được lưu trên CoCo; có thể gửi bằng biểu mẫu này.</p>
<div id="conversation-thread" class="panel mb-3 message-thread" role="log" aria-live="polite"
     aria-label="Nội dung trò chuyện" data-conversation-id="@Model.Summary.Id" data-current-user-id="@myId">
    @if (Model.Messages.Count == 0) { <p id="empty-conversation" class="subtitle mb-0">Hãy gửi lời nhắn đầu tiên để bắt đầu trò chuyện.</p> }
    @foreach (var message in Model.Messages)
    {
        <div class="message-row @(message.SenderId == myId ? "mine" : "theirs")" data-message-id="@message.Id"><div class="message-bubble"><p class="mb-1" style="white-space:pre-wrap">@message.Body</p><small>@message.CreatedAtUtc.ToLocalTime().ToString("dd/MM HH:mm")</small></div></div>
    }
</div>
<form id="message-form" asp-action="Send" method="post" class="panel mb-5"><input type="hidden" name="id" value="@Model.Summary.Id" /><label for="body" class="form-label">Tin nhắn</label><textarea id="body" name="body" class="form-control" rows="3" maxlength="1000" required></textarea><div id="message-error" class="text-danger small mt-2" role="alert" hidden></div><button type="submit" class="btn btn-wine mt-3">Gửi tin nhắn</button></form>

@section Scripts {
    <script src="~/js/conversation.js" asp-append-version="true"></script>
}
