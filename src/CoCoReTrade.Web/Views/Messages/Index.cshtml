@model IReadOnlyList<ConversationSummary>
@{ ViewData["Title"] = "Tin nhắn"; }
<div class="page-heading"><div><span class="eyebrow">Trò chuyện trên CoCo</span><h1 class="page-title">Tin nhắn</h1><p class="subtitle mb-0">Hỏi thêm về món đồ và trao đổi trực tiếp với người mua, người bán.</p></div><a class="text-link" asp-controller="Support" asp-action="Index">Cần CoCo hỗ trợ? <svg class="icon" aria-hidden="true"><use href="/images/icons.svg#arrow-right" /></svg></a></div>
@if (Model.Count == 0)
{
    <div class="empty-state"><div class="empty-icon"><svg class="icon" aria-hidden="true"><use href="/images/icons.svg#message" /></svg></div><h2>Bắt đầu cuộc trò chuyện đầu tiên</h2><p>Tại trang sản phẩm, chọn “Nhắn người bán” để hỏi thêm về món đồ bạn thích.</p><a class="btn btn-wine mt-2" asp-controller="Shop" asp-action="Index">Khám phá sản phẩm</a></div>
}
else
{
    <div class="conversation-list d-grid gap-3">
        @foreach (var conversation in Model)
        {
            <a class="panel conversation-item d-flex align-items-center gap-3 @(conversation.UnreadCount > 0 ? "is-unread" : "")" asp-action="Details" asp-route-id="@conversation.Id">
                <span class="conversation-avatar flex-shrink-0" aria-hidden="true">@(string.IsNullOrWhiteSpace(conversation.OtherUserName) ? "C" : conversation.OtherUserName.Trim()[0].ToString())</span>
                <div class="flex-grow-1"><div class="d-flex flex-wrap justify-content-between align-items-center gap-2"><h2 class="h6 mb-0">@conversation.OtherUserName</h2><time class="small text-muted">@conversation.LastMessageAtUtc.ToLocalTime().ToString("dd/MM · HH:mm")</time></div><p class="conversation-product mt-1 mb-1">@conversation.ProductName</p><span class="small text-muted">Mã sản phẩm: @conversation.ProductSku</span></div>
                @if (conversation.UnreadCount > 0) { <span class="badge rounded-pill text-bg-danger">@conversation.UnreadCount <span class="visually-hidden">tin nhắn chưa đọc</span></span> }
                <svg class="icon flex-shrink-0" aria-hidden="true"><use href="/images/icons.svg#chevron-right" /></svg>
            </a>
        }
    </div>
}
