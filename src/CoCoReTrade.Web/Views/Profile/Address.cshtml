@model AddressForm
@{ ViewData["Title"] = Model.Id.HasValue ? "Sửa địa chỉ" : "Thêm địa chỉ"; }
<div class="mt-4 mb-3"><a asp-action="Addresses">← Sổ địa chỉ</a></div><h1 class="page-title">@ViewData["Title"]</h1>
<form asp-action="Address" method="post" class="panel mb-5" style="max-width:720px"><input asp-for="Id" type="hidden" /><div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <div class="row g-3"><div class="col-sm-6"><label asp-for="RecipientName" class="form-label"></label><input asp-for="RecipientName" class="form-control" /><span asp-validation-for="RecipientName" class="text-danger"></span></div>
    <div class="col-sm-6"><label asp-for="RecipientPhone" class="form-label"></label><input asp-for="RecipientPhone" class="form-control" inputmode="tel" /><span asp-validation-for="RecipientPhone" class="text-danger"></span></div>
    <div class="col-sm-6"><label asp-for="Province" class="form-label"></label><input asp-for="Province" class="form-control" /><span asp-validation-for="Province" class="text-danger"></span></div>
    <div class="col-sm-6"><label asp-for="Ward" class="form-label"></label><input asp-for="Ward" class="form-control" /><span asp-validation-for="Ward" class="text-danger"></span></div>
    <div class="col-12"><label asp-for="StreetAddress" class="form-label"></label><input asp-for="StreetAddress" class="form-control" /><span asp-validation-for="StreetAddress" class="text-danger"></span></div></div>
    <button class="btn btn-wine mt-4" type="submit">Lưu địa chỉ</button>
</form>
