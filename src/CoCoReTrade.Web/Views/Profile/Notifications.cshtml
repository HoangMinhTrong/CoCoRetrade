@model IReadOnlyList<NotificationDto>
@{ ViewData["Title"] = "Thông báo"; }
<div class="eyebrow mt-4">Cập nhật CoCo</div><h1 class="page-title mt-1">Thông báo</h1>
<nav class="d-flex flex-wrap gap-2 mb-3" aria-label="Nhóm thông báo"><a class="btn btn-sm @((string?)ViewBag.Group is null ? "btn-wine" : "btn-outline-wine")" asp-action="Notifications">Tất cả</a><a class="btn btn-sm @((string?)ViewBag.Group == "transactions" ? "btn-wine" : "btn-outline-wine")" asp-action="Notifications" asp-route-group="transactions">Giao dịch & Offer</a><a class="btn btn-sm @((string?)ViewBag.Group == "listings" ? "btn-wine" : "btn-outline-wine")" asp-action="Notifications" asp-route-group="listings">Sản phẩm</a><a class="btn btn-sm @((string?)ViewBag.Group == "social" ? "btn-wine" : "btn-outline-wine")" asp-action="Notifications" asp-route-group="social">Tương tác</a></nav>
@if (Model.Count == 0) { <div class="empty-state mt-4"><div class="empty-icon">✉</div><h2 class="display-serif">Chưa có thông báo</h2><p>Hoạt động trả giá sẽ xuất hiện tại đây.</p></div> }
else { <div class="row g-2 mt-3 mb-5">@foreach (var item in Model) { <div class="col-12"><div class="panel py-3 d-flex justify-content-between align-items-center gap-3"><div><div class="eyebrow">@(item.IsRead ? "Đã đọc" : "● Mới") · @item.Category · @item.CreatedAtUtc.ToLocalTime().ToString("dd/MM HH:mm")</div><p class="mb-0 mt-1">@item.Message</p></div><div class="d-flex flex-column gap-2">@if (item.OfferId.HasValue) { <a asp-controller="Offers" asp-action="Details" asp-route-id="@item.OfferId">Xem →</a> } else if (item.OrderId.HasValue) { <a asp-controller="Orders" asp-action="Details" asp-route-id="@item.OrderId">Xem →</a> }@if (!item.IsRead) { <form asp-action="ReadNotification" method="post"><input type="hidden" name="id" value="@item.Id" /><button type="submit" class="btn btn-outline-wine btn-sm">Đánh dấu đã đọc</button></form> }</div></div></div> }</div> }
