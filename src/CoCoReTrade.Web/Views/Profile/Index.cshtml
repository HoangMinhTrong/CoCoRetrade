@{ ViewData["Title"] = "Tài khoản của tôi"; var wallet = (WalletBalanceDto)ViewBag.Balance; var profile = (UserProfileDto?)ViewBag.UserProfile; }
<div class="d-flex align-items-center gap-3 mt-4 mb-3">
    @if (profile?.HasAvatar == true) { <img class="seller-avatar" src="/avatars/@profile.Id" alt="Ảnh đại diện" /> }
    else { <span class="seller-avatar seller-avatar-empty" aria-hidden="true">CoCo</span> }
    <div><div class="eyebrow">Góc của bạn</div><h1 class="page-title mt-1 mb-1">Xin chào, @(profile?.FullName ?? User.Identity?.Name)</h1><p class="subtitle mb-0">Điểm tín nhiệm: @(profile?.TrustScore ?? 100)/100</p></div>
</div>
<form asp-action="Avatar" method="post" enctype="multipart/form-data" class="d-flex flex-wrap align-items-center gap-2 mb-4"><label for="avatarImage" class="small">Đổi ảnh đại diện</label><input id="avatarImage" name="image" type="file" accept="image/jpeg,image/png,image/webp" required class="form-control form-control-sm" style="max-width:260px" /><button type="submit" class="btn btn-outline-wine btn-sm">Lưu ảnh</button></form>
<div class="panel mb-4 d-flex flex-wrap align-items-center justify-content-between gap-3"><div><div class="eyebrow">Ví ký gửi CoCo</div><strong class="fs-4">@wallet.Available.ToString("N0")đ khả dụng</strong></div><a asp-action="Wallet" class="btn btn-wine">Xem ví & rút tiền →</a></div>
<div class="d-flex flex-wrap gap-2 mb-4"><a asp-controller="Messages" asp-action="Index" class="btn btn-outline-wine">Tin nhắn</a><a asp-controller="Cart" asp-action="Index" class="btn btn-outline-wine">Giỏ hàng</a><a asp-action="Saved" class="btn btn-outline-wine">♡ Đồ đã lưu</a><a asp-action="Addresses" class="btn btn-outline-wine">Sổ địa chỉ</a><a asp-action="Notifications" class="btn btn-outline-wine">Thông báo</a><a asp-controller="Support" asp-action="Index" class="btn btn-outline-wine">Trợ giúp CSKH</a><a asp-controller="Home" asp-action="Terms" class="btn btn-outline-wine">Quy định sàn</a></div>
<div class="row g-3 mb-5"><div class="col-md-3"><div class="panel h-100"><div class="eyebrow mb-2">Bán hàng</div><h2 class="display-serif fs-4">Tủ đồ của tôi</h2><p class="subtitle">Theo dõi đồ đang chờ duyệt, đang bán và bị từ chối.</p><a class="btn btn-wine" asp-controller="Listing" asp-action="Closet">Mở tủ đồ →</a></div></div><div class="col-md-3"><div class="panel h-100"><div class="eyebrow mb-2">Giao dịch</div><h2 class="display-serif fs-4">Đề xuất giá</h2><p class="subtitle">Xem giá đã gửi, phản hồi người mua và chốt giá.</p><a class="btn btn-wine" asp-controller="Offers" asp-action="Index">Xem đề xuất →</a></div></div><div class="col-md-3"><div class="panel h-100"><div class="eyebrow mb-2">Mua & bán</div><h2 class="display-serif fs-4">Đơn hàng</h2><p class="subtitle">Theo dõi đơn đang xử lý, nhận hàng và đã hoàn tất.</p><a class="btn btn-wine" asp-controller="Orders" asp-action="Index">Xem đơn →</a></div></div><div class="col-md-3"><div class="panel h-100"><div class="eyebrow mb-2">Cài đặt</div><h2 class="display-serif fs-4">Bảo mật tài khoản</h2><p class="subtitle">Cập nhật mật khẩu và quản lý quyền truy cập.</p><a class="btn btn-outline-wine" asp-controller="Account" asp-action="ChangePassword">Đổi mật khẩu</a></div></div></div>
@if (User.IsInRole("Admin")) { <div class="panel mb-4"><div class="eyebrow mb-2">Quản trị CoCo</div><h2 class="display-serif fs-4">Kiểm định & Đơn hàng</h2><div class="d-flex gap-2 flex-wrap"><a class="btn btn-wine" asp-area="Admin" asp-controller="Inspection" asp-action="Index">Kiểm định →</a><a class="btn btn-outline-wine" asp-area="Admin" asp-controller="Orders" asp-action="Index">Quản lý đơn →</a><a class="btn btn-outline-wine" asp-area="Admin" asp-controller="HelpDesk" asp-action="Index">Yêu cầu hỗ trợ →</a></div></div> }
<form asp-controller="Account" asp-action="Logout" method="post"><button type="submit" class="btn btn-outline-danger">Đăng xuất</button></form>
