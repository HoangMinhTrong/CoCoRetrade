@using Microsoft.AspNetCore.Authorization
@inject IAuthorizationService Authorization
@{
    ViewData["Title"] = "Tài khoản của tôi";
    var wallet = (WalletBalanceDto)ViewBag.Balance;
    var profile = (UserProfileDto?)ViewBag.UserProfile;
    var displayName = profile?.FullName ?? User.Identity?.Name ?? "bạn";
    var canManage = (await Authorization.AuthorizeAsync(User, StaffPermissions.ReadPending)).Succeeded;
}
<div class="page-heading"><div><span class="eyebrow">Góc của bạn</span><h1 class="page-title">Tài khoản của tôi</h1><p class="subtitle mb-0">Tủ đồ, mua sắm và những cập nhật của bạn ở cùng một nơi.</p></div></div>
<section class="panel profile-overview mb-4">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3">
        <div class="d-flex align-items-center gap-3">
            @if (profile?.HasAvatar == true) { <img class="seller-avatar" src="/avatars/@profile.Id" alt="Ảnh đại diện của @displayName" /> }
            else { <span class="seller-avatar seller-avatar-empty" aria-hidden="true">@(string.IsNullOrWhiteSpace(displayName) ? "C" : displayName.Trim()[0].ToString())</span> }
            <div><h2 class="h4 mb-1">Xin chào, @displayName</h2><span class="small text-muted"><svg class="icon" aria-hidden="true"><use href="/images/icons.svg#shield" /></svg> Điểm tín nhiệm @(profile?.TrustScore ?? 100)/100</span></div>
        </div>
        <a class="btn btn-wine" asp-controller="Listing" asp-action="Create"><svg class="icon" aria-hidden="true"><use href="/images/icons.svg#plus" /></svg> Ký gửi món đồ</a>
    </div>
    <details class="profile-avatar-editor mt-3">
        <summary class="small text-link">Thay đổi ảnh đại diện</summary>
        <form asp-action="Avatar" method="post" enctype="multipart/form-data" class="row g-2 align-items-end mt-2">
            <div class="col-sm-8"><label for="avatarImage" class="form-label">Chọn ảnh mới</label><input id="avatarImage" name="image" type="file" accept="image/jpeg,image/png,image/webp" required class="form-control" /></div>
            <div class="col-sm-4"><button type="submit" class="btn btn-outline-wine w-100">Lưu ảnh đại diện</button></div>
        </form>
    </details>
</section>
<div class="row g-4">
    <div class="col-lg-8">
        <div class="row g-4">
            <section class="col-md-6"><div class="panel h-100 account-section"><h2 class="h5 mb-3">Mua sắm của tôi</h2>
                <a class="account-menu-row" asp-controller="Orders" asp-action="Index"><svg class="icon" aria-hidden="true"><use href="/images/icons.svg#package" /></svg><span><strong>Đơn hàng</strong><small>Theo dõi đơn mua và đơn bán</small></span><svg class="icon" aria-hidden="true"><use href="/images/icons.svg#chevron-right" /></svg></a>
                <a class="account-menu-row" asp-controller="Cart" asp-action="Index"><svg class="icon" aria-hidden="true"><use href="/images/icons.svg#bag" /></svg><span><strong>Giỏ hàng</strong><small>Những món đồ bạn đang chọn</small></span><svg class="icon" aria-hidden="true"><use href="/images/icons.svg#chevron-right" /></svg></a>
                <a class="account-menu-row" asp-action="Saved"><svg class="icon" aria-hidden="true"><use href="/images/icons.svg#heart" /></svg><span><strong>Đồ đã lưu</strong><small>Xem lại những món hợp gu</small></span><svg class="icon" aria-hidden="true"><use href="/images/icons.svg#chevron-right" /></svg></a>
                <a class="account-menu-row" asp-action="Addresses"><svg class="icon" aria-hidden="true"><use href="/images/icons.svg#home" /></svg><span><strong>Sổ địa chỉ</strong><small>Quản lý địa chỉ nhận hàng</small></span><svg class="icon" aria-hidden="true"><use href="/images/icons.svg#chevron-right" /></svg></a>
            </div></section>
            <section class="col-md-6"><div class="panel h-100 account-section"><h2 class="h5 mb-3">Ký gửi và giao dịch</h2>
                <a class="account-menu-row" asp-controller="Listing" asp-action="Closet"><svg class="icon" aria-hidden="true"><use href="/images/icons.svg#tag" /></svg><span><strong>Tủ đồ của tôi</strong><small>Chờ duyệt, đang bán và đã bán</small></span><svg class="icon" aria-hidden="true"><use href="/images/icons.svg#chevron-right" /></svg></a>
                <a class="account-menu-row" asp-controller="Offers" asp-action="Index"><svg class="icon" aria-hidden="true"><use href="/images/icons.svg#tag" /></svg><span><strong>Đề xuất giá</strong><small>Giá đã gửi và phản hồi nhận được</small></span><svg class="icon" aria-hidden="true"><use href="/images/icons.svg#chevron-right" /></svg></a>
                <a class="account-menu-row" asp-controller="Messages" asp-action="Index"><svg class="icon" aria-hidden="true"><use href="/images/icons.svg#message" /></svg><span><strong>Tin nhắn</strong><small>Trò chuyện với người mua, người bán</small></span><svg class="icon" aria-hidden="true"><use href="/images/icons.svg#chevron-right" /></svg></a>
                <a class="account-menu-row" asp-action="Notifications"><svg class="icon" aria-hidden="true"><use href="/images/icons.svg#bell" /></svg><span><strong>Thông báo</strong><small>Cập nhật mới từ CoCo</small></span><svg class="icon" aria-hidden="true"><use href="/images/icons.svg#chevron-right" /></svg></a>
            </div></section>
            <section class="col-12"><div class="panel account-section"><h2 class="h5 mb-3">Tài khoản và hỗ trợ</h2>
                <div class="row gx-4">
                    <div class="col-md-6"><a class="account-menu-row" asp-controller="Account" asp-action="ChangePassword"><svg class="icon" aria-hidden="true"><use href="/images/icons.svg#shield" /></svg><span><strong>Đổi mật khẩu</strong><small>Bảo vệ tài khoản của bạn</small></span><svg class="icon" aria-hidden="true"><use href="/images/icons.svg#chevron-right" /></svg></a></div>
                    <div class="col-md-6"><a class="account-menu-row" asp-controller="Support" asp-action="Index"><svg class="icon" aria-hidden="true"><use href="/images/icons.svg#message" /></svg><span><strong>Trợ giúp CoCo</strong><small>Gửi câu hỏi cho nhân viên hỗ trợ</small></span><svg class="icon" aria-hidden="true"><use href="/images/icons.svg#chevron-right" /></svg></a></div>
                    <div class="col-md-6"><a class="account-menu-row" asp-controller="Home" asp-action="Terms"><svg class="icon" aria-hidden="true"><use href="/images/icons.svg#check" /></svg><span><strong>Quy định sàn</strong><small>Chính sách mua bán và ký gửi</small></span><svg class="icon" aria-hidden="true"><use href="/images/icons.svg#chevron-right" /></svg></a></div>
                </div>
                <form asp-controller="Account" asp-action="Logout" method="post" class="mt-3"><button type="submit" class="btn btn-outline-danger btn-sm">Đăng xuất</button></form>
            </div></section>
        </div>
    </div>
    <aside class="col-lg-4">
        <div class="panel wallet-overview mb-4"><span class="eyebrow">Ví ký gửi CoCo</span><p class="small text-muted mt-3 mb-1">Số dư khả dụng</p><strong class="wallet-amount d-block">@wallet.Available.ToString("N0") <span>VNĐ</span></strong><p class="small subtitle mt-3">Theo dõi tiền bán hàng và yêu cầu rút tiền về tài khoản ngân hàng.</p><a asp-action="Wallet" class="btn btn-wine w-100">Xem ví và rút tiền <svg class="icon" aria-hidden="true"><use href="/images/icons.svg#arrow-right" /></svg></a></div>
        @if (canManage)
        {
            <div class="panel account-section"><span class="eyebrow">Dành cho nhân viên CoCo</span><h2 class="h5 mt-2 mb-3">Quản trị và kiểm định</h2><p class="small subtitle">Mở không gian làm việc để theo dõi các công việc được phân quyền.</p><a class="btn btn-outline-wine w-100" asp-area="Admin" asp-controller="Dashboard" asp-action="Index">Mở trang quản trị / kiểm định <svg class="icon" aria-hidden="true"><use href="/images/icons.svg#arrow-right" /></svg></a></div>
        }
    </aside>
</div>
