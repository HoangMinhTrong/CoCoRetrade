<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#783d48" />
    <title>@ViewData["Title"] · CoCo ReTrade</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    @if (Context.RequestServices.GetRequiredService<IConfiguration>().GetValue<bool>("Preview:Enabled") && Context.RequestServices.GetRequiredService<IWebHostEnvironment>().IsDevelopment())
    {
        <div class="preview-banner">Bản xem giao diện · dữ liệu minh họa · cần SQL Server để đăng nhập và giao dịch <a asp-controller="Preview" asp-action="Index">Xem các màn hình →</a></div>
    }
    <header class="site-header">
        <div class="container d-flex align-items-center justify-content-between py-3">
            <a class="brand" asp-area="" asp-controller="Home" asp-action="Index"><span class="brand-mark">C<span>o</span>C<span>o</span></span><span class="brand-sub">RETRADE</span></a>
            <nav class="d-none d-lg-flex align-items-center gap-4 main-nav" aria-label="Điều hướng chính">
                <a asp-area="" asp-controller="Home" asp-action="Index">Trang chủ</a>
                <a asp-area="" asp-controller="Shop" asp-action="Index">Khám phá</a>
                <a asp-area="" asp-controller="Listing" asp-action="Create">Đăng bán</a>
                @if (User.IsInRole("Admin")) { <a asp-area="Admin" asp-controller="Inspection" asp-action="Index">Kiểm định</a><a asp-area="Admin" asp-controller="Orders" asp-action="Index">Đơn hàng</a> }
                @if (User.HasClaim(StaffPermissions.ClaimType, StaffPermissions.ReadPending) && !User.IsInRole("Admin"))
                { <a asp-area="Admin" asp-controller="Inspection" asp-action="Index">Kiểm định</a> }
                @if (User.IsInRole("Admin"))
                { <a asp-area="Admin" asp-controller="Dashboard" asp-action="Index">Quản trị</a><a asp-area="Admin" asp-controller="HelpDesk" asp-action="Index">Hỗ trợ</a> }
            </nav>
            <div class="d-flex align-items-center gap-2 header-actions">
                @if (User.Identity?.IsAuthenticated == true)
                {
                    <a class="icon-link unread-link" asp-area="" asp-controller="Messages" asp-action="Index" aria-label="Tin nhắn" data-unread-label="Tin nhắn" title="Tin nhắn">✉<span class="unread-count" data-unread-badge="messages" aria-hidden="true" hidden></span></a>
                    <a class="icon-link" asp-area="" asp-controller="Cart" asp-action="Index" aria-label="Giỏ hàng" title="Giỏ hàng">🛍</a>
                    <a class="icon-link unread-link" asp-area="" asp-controller="Profile" asp-action="Notifications" aria-label="Thông báo" data-unread-label="Thông báo" title="Thông báo">♡<span class="unread-count" data-unread-badge="notifications" aria-hidden="true" hidden></span></a>
                    <a class="btn btn-dark btn-sm rounded-pill px-3 d-none d-sm-inline-block" asp-area="" asp-controller="Profile" asp-action="Index">Tài khoản</a>
                }
                else
                {
                    <a class="btn btn-outline-dark btn-sm rounded-pill px-3" asp-area="" asp-controller="Account" asp-action="Login">Đăng nhập</a>
                }
            </div>
        </div>
        @if (User.IsInRole("Admin"))
        {
            <div class="admin-strip"><div class="container">Tài khoản kiểm định viên <span>·</span> <a asp-area="Admin" asp-controller="Inspection" asp-action="Index">Sản phẩm chờ duyệt</a> <span>·</span> <a asp-area="Admin" asp-controller="Orders" asp-action="Index">Quản lý đơn hàng →</a></div></div>
        }
        @if (User.HasClaim(StaffPermissions.ClaimType, StaffPermissions.ReadPending) && !User.IsInRole("Admin"))
        { <div class="admin-strip"><div class="container"><a asp-area="Admin" asp-controller="Inspection" asp-action="Index">Ký gửi chờ kiểm định →</a></div></div> }
    </header>
    <main class="container content-wrap" role="main">
        @if (TempData["Message"] is string message) { <div class="alert alert-success mt-3" role="status">@message</div> }
        @if (TempData["Error"] is string error) { <div class="alert alert-danger mt-3" role="alert">@error</div> }
        @RenderBody()
    </main>
    <footer class="site-footer d-none d-lg-block"><div class="container d-flex justify-content-between"><span>© 2026 CoCo ReTrade · Thời trang tuần hoàn có kiểm định</span><span>Ký gửi có chọn lọc · Mua sắm an tâm</span></div></footer>
    <nav class="bottom-nav d-lg-none" aria-label="Điều hướng di động">
        <a asp-area="" asp-controller="Home" asp-action="Index"><span>⌂</span><small>Trang chủ</small></a>
        <a asp-area="" asp-controller="Shop" asp-action="Index"><span>⌕</span><small>Tìm kiếm</small></a>
        <a class="sell-tab" asp-area="" asp-controller="Listing" asp-action="Create"><span>+</span><small>Đăng bán</small></a>
        <a class="unread-link" asp-area="" asp-controller="Profile" asp-action="Notifications" aria-label="Thông báo" data-unread-label="Thông báo"><span class="nav-icon">♧<span class="unread-count" data-unread-badge="notifications" aria-hidden="true" hidden></span></span><small>Thông báo</small></a>
        <a asp-area="" asp-controller="Profile" asp-action="Index"><span>♙</span><small>Tôi</small></a>
    </nav>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    @if (User.Identity?.IsAuthenticated == true)
    { <script src="~/lib/signalr/signalr.min.js" asp-append-version="true"></script> }
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
