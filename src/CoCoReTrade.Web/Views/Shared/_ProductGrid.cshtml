@model IReadOnlyList<ProductCard>
@{ var savedIds = ((IEnumerable<Guid>?)ViewBag.FavoriteIds ?? []).ToHashSet(); }
@if (Model.Count == 0)
{
    <div class="empty-state"><div class="empty-icon">✦</div><h3 class="display-serif">Chưa có sản phẩm phù hợp</h3><p>Sản phẩm sẽ xuất hiện ở đây sau khi CoCo kiểm định và duyệt lên sàn.</p><a class="btn btn-outline-wine mt-2" asp-controller="Listing" asp-action="Create">Đăng món đồ đầu tiên</a></div>
}
else
{
    <div class="row row-cols-2 row-cols-md-3 row-cols-xl-4 g-3 g-md-4">
    @foreach (var p in Model)
    {
        <div class="col"><article class="product-card">
            <a class="product-photo" asp-area="" asp-controller="Shop" asp-action="Details" asp-route-id="@p.Id">
                @if (p.CoverImageId.HasValue) { <img src="/images/@p.CoverImageId" alt="@p.Name" loading="lazy" /> }
                else { <span class="product-placeholder">CoCo</span> }
                @if (p.Status == ProductStatus.Active) { <span class="verified-badge">✓ Verified by CoCo</span> }
            </a>
            <div class="product-body"><div class="product-meta">@p.Brand · Size @p.Size · @p.ConditionPercent%</div>
                @if (p.Status != ProductStatus.Active && !string.IsNullOrEmpty(p.ConsignmentCode)) { <div class="small text-muted">Mã ký gửi: @p.ConsignmentCode</div> }
                <h3><a asp-area="" asp-controller="Shop" asp-action="Details" asp-route-id="@p.Id">@p.Name</a></h3>
                <div class="d-flex justify-content-between align-items-center gap-1"><span class="product-price">@p.AskingPrice.ToString("N0")đ</span>
                @if (p.Status != ProductStatus.Active) { <span class="status-pill @p.Status">@p.Status</span> }</div>
                @if (!string.IsNullOrWhiteSpace(p.SellerName))
                { <div class="product-seller small mt-2 d-flex align-items-center gap-2">@if (p.SellerHasAvatar) { <img class="seller-avatar seller-avatar-small" src="/avatars/@p.SellerId" alt="" /> }<a asp-area="" asp-controller="Sellers" asp-action="Index" asp-route-id="@p.SellerId">Tủ đồ @p.SellerName</a></div> }
                @if (p.Status == ProductStatus.Active)
                {
                    <div class="d-flex align-items-center gap-2 mt-2">
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <form asp-area="" asp-controller="Social" asp-action="Favorite" method="post">
                            <input type="hidden" name="productId" value="@p.Id" />
                            <input type="hidden" name="selected" value="@(!savedIds.Contains(p.Id) ? "true" : "false")" />
                            <input type="hidden" name="returnUrl" value="@(Context.Request.Path + Context.Request.QueryString)" />
                            <button class="btn btn-sm btn-outline-wine" type="submit" aria-label="@(savedIds.Contains(p.Id) ? "Bỏ thích" : "Thích") @p.Name">@(savedIds.Contains(p.Id) ? "♥" : "♡") @p.LikeCount</button>
                        </form>
                    }
                    else { <a class="small" asp-area="" asp-controller="Account" asp-action="Login">♡ @p.LikeCount</a> }
                    </div>
                }
            </div>
        </article></div>
    }
    </div>
}
