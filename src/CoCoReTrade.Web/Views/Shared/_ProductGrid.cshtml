@model IReadOnlyList<ProductCard>
@{ var savedIds = ((IEnumerable<Guid>?)ViewBag.FavoriteIds ?? []).ToHashSet(); }
@if (Model.Count == 0)
{
    <div class="empty-state"><div class="empty-icon"><svg class="icon" aria-hidden="true"><use href="/images/icons.svg#bag" /></svg></div><h3>Chưa tìm thấy món đồ phù hợp</h3><p>Thử đổi từ khóa hoặc bớt bộ lọc. Những món đồ mới sẽ xuất hiện sau khi được CoCo duyệt.</p><a class="btn btn-outline-wine mt-2" asp-area="" asp-controller="Shop" asp-action="Index">Khám phá tất cả</a></div>
}
else
{
    <div class="row row-cols-2 row-cols-md-3 row-cols-xl-4 g-3 g-md-4">
    @foreach (var p in Model)
    {
        <div class="col"><article class="product-card">
            <div class="product-card-media">
                <a class="product-photo" asp-area="" asp-controller="Shop" asp-action="Details" asp-route-id="@p.Id">
                    @if (p.CoverImageId.HasValue) { <img src="/images/@p.CoverImageId" alt="@p.Name" loading="lazy" /> }
                    else { <span class="product-placeholder"><svg class="icon" aria-hidden="true"><use href="/images/icons.svg#bag" /></svg></span> }
                    @if (p.Status == ProductStatus.Active) { <span class="verified-badge"><svg class="icon" aria-hidden="true"><use href="/images/icons.svg#check" /></svg> CoCo đã kiểm định</span> }
                </a>
                @if (p.Status == ProductStatus.Active)
                {
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <form asp-area="" asp-controller="Social" asp-action="Favorite" method="post" class="product-card-favorite">
                            <input type="hidden" name="productId" value="@p.Id" />
                            <input type="hidden" name="selected" value="@(!savedIds.Contains(p.Id) ? "true" : "false")" />
                            <input type="hidden" name="returnUrl" value="@(Context.Request.Path + Context.Request.QueryString)" />
                            <button class="favorite-button @(savedIds.Contains(p.Id) ? "is-saved" : "")" type="submit" aria-label="@(savedIds.Contains(p.Id) ? "Bỏ lưu" : "Lưu") @p.Name" aria-pressed="@(savedIds.Contains(p.Id) ? "true" : "false")"><svg class="icon" aria-hidden="true"><use href="/images/icons.svg#heart" /></svg></button>
                        </form>
                    }
                    else { <a class="favorite-button product-card-favorite" asp-area="" asp-controller="Account" asp-action="Login" aria-label="Đăng nhập để lưu @p.Name"><svg class="icon" aria-hidden="true"><use href="/images/icons.svg#heart" /></svg></a> }
                }
            </div>
            <div class="product-body">
                <div class="product-card-brand">@p.Brand</div>
                <h3><a asp-area="" asp-controller="Shop" asp-action="Details" asp-route-id="@p.Id">@p.Name</a></h3>
                <div class="product-meta">Cỡ @UiText.For(p.Size) <span aria-hidden="true">·</span> Mới @p.ConditionPercent%</div>
                @if (p.Status != ProductStatus.Active && !string.IsNullOrEmpty(p.ConsignmentCode)) { <div class="small text-muted mt-1">Mã chờ duyệt: @p.ConsignmentCode</div> }
                <div class="d-flex flex-wrap justify-content-between align-items-center gap-1 mt-2"><span class="product-price">@p.AskingPrice.ToString("N0") VNĐ</span>
                @if (p.Status != ProductStatus.Active) { <span class="status-pill @p.Status">@UiText.For(p.Status)</span> }
                else if (p.LikeCount > 0) { <span class="product-likes" aria-label="@p.LikeCount lượt yêu thích"><svg class="icon" aria-hidden="true"><use href="/images/icons.svg#heart" /></svg> @p.LikeCount</span> }</div>
                @if (!string.IsNullOrWhiteSpace(p.SellerName))
                {
                    <div class="product-seller small d-flex align-items-center gap-2">
                        @if (p.SellerHasAvatar) { <img class="seller-avatar seller-avatar-small" src="/avatars/@p.SellerId" alt="" loading="lazy" /> }
                        else { <span class="seller-initial" aria-hidden="true">@p.SellerName.Trim()[0]</span> }
                        <a asp-area="" asp-controller="Sellers" asp-action="Index" asp-route-id="@p.SellerId">@p.SellerName</a>
                    </div>
                }
            </div>
        </article></div>
    }
    </div>
}
