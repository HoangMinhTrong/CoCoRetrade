@model ListingForm
@{ ViewData["Title"] = "Ký gửi món đồ"; }
<div class="page-heading"><div><span class="eyebrow">Thêm một vòng đời cho món đồ</span><h1 class="page-title">Ký gửi cùng CoCo</h1><p class="subtitle mb-0">Một vài thông tin và hình ảnh để bắt đầu hành trình tìm chủ mới.</p></div><a class="text-link" asp-action="Closet">Tủ đồ của tôi <svg class="icon" aria-hidden="true"><use href="/images/icons.svg#arrow-right" /></svg></a></div>
<div class="row g-4">
    <div class="col-lg-8">
        <form asp-action="Create" method="post" enctype="multipart/form-data" class="listing-form">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3" role="alert"></div>
            <section class="panel mb-4" aria-labelledby="photos-title">
                <div class="form-section-heading"><span class="step-number">1</span><div><h2 id="photos-title" class="h5 mb-1">Ảnh thật của món đồ</h2><p class="small subtitle mb-0">Ảnh rõ giúp CoCo kiểm định và người mua dễ lựa chọn.</p></div></div>
                <div class="upload-panel mt-4">
                    <label asp-for="Images" class="form-label"></label><input asp-for="Images" class="form-control" type="file" accept="image/jpeg,image/png,image/webp" multiple required data-preview="photoPreview" aria-describedby="images-help" /><span asp-validation-for="Images" class="text-danger small"></span>
                    <div id="images-help" class="form-text mt-2">Chọn từ 3 đến 10 ảnh: mặt trước, tem thương hiệu và cận cảnh tình trạng. JPG, PNG hoặc WebP, tối đa 5 MB mỗi ảnh.</div><div id="photoPreview" class="photo-preview"></div>
                </div>
            </section>
            <section class="panel mb-4" aria-labelledby="product-info-title">
                <div class="form-section-heading"><span class="step-number">2</span><div><h2 id="product-info-title" class="h5 mb-1">Giới thiệu món đồ</h2><p class="small subtitle mb-0">Mô tả đúng thương hiệu, kích cỡ và tình trạng hiện tại.</p></div></div>
                <div class="row g-3 mt-1">
                    <div class="col-md-8"><label asp-for="Name" class="form-label"></label><input asp-for="Name" class="form-control" placeholder="Ví dụ: Áo sơ mi linen Zara" /><span asp-validation-for="Name" class="text-danger small"></span></div>
                    <div class="col-md-4"><label asp-for="Brand" class="form-label"></label><input asp-for="Brand" class="form-control" placeholder="Ví dụ: Zara" /><span asp-validation-for="Brand" class="text-danger small"></span></div>
                    <div class="col-md-6"><label asp-for="Category" class="form-label"></label><select asp-for="Category" class="form-select"><option value="">Chọn danh mục</option><option>Áo</option><option>Quần</option><option>Đầm/Váy</option><option>Túi</option><option>Phụ kiện</option></select><span asp-validation-for="Category" class="text-danger small"></span></div>
                    <div class="col-md-6"><label asp-for="Size" class="form-label"></label><select asp-for="Size" class="form-select"><option value="">Chọn kích cỡ</option><option>XS</option><option>S</option><option>M</option><option>L</option><option>XL</option><option value="Free size">Kích cỡ tự do</option></select><span asp-validation-for="Size" class="text-danger small"></span></div>
                    <div class="col-md-6"><label asp-for="ConditionPercent" class="form-label"></label><select asp-for="ConditionPercent" class="form-select"><option value="99">Như mới 99%</option><option value="95">Rất tốt 95%</option><option value="90">Tốt 90%</option><option value="85">Khá 85%</option><option value="80">Đã qua sử dụng 80%</option></select><span asp-validation-for="ConditionPercent" class="text-danger small"></span></div>
                </div>
            </section>
            <section class="panel mb-4" aria-labelledby="price-title">
                <div class="form-section-heading"><span class="step-number">3</span><div><h2 id="price-title" class="h5 mb-1">Mức giá bạn mong muốn</h2><p class="small subtitle mb-0">Nhập số tiền theo Việt Nam đồng.</p></div></div>
                <div class="row g-3 mt-1">
                    <div class="col-md-6"><label asp-for="OriginalPrice" class="form-label"></label><div class="input-group"><input asp-for="OriginalPrice" class="form-control" type="number" min="1000" step="1" placeholder="Ví dụ: 50000" /><span class="input-group-text">VNĐ</span></div><span asp-validation-for="OriginalPrice" class="text-danger small"></span></div>
                    <div class="col-md-6"><label asp-for="AskingPrice" class="form-label"></label><div class="input-group"><input asp-for="AskingPrice" class="form-control" type="number" min="1000" step="1" placeholder="Ví dụ: 29000" /><span class="input-group-text">VNĐ</span></div><span asp-validation-for="AskingPrice" class="text-danger small"></span></div>
                    <div class="col-12"><p class="form-text mb-0">Nhập đủ số tiền bằng VNĐ: nhập <strong>29000</strong> để hiển thị <strong>29,000 VNĐ</strong>. Giá tối thiểu 1,000 VNĐ.</p></div>
                    <div class="col-12"><div class="form-check form-switch mt-2"><input asp-for="AllowOffers" class="form-check-input" /><label asp-for="AllowOffers" class="form-check-label">Cho phép người mua đề xuất giá</label></div><p class="small subtitle mt-1 mb-0">Bạn có thể chấp nhận, từ chối hoặc đề xuất lại sau khi sản phẩm được duyệt.</p></div>
                </div>
            </section>
            <div class="listing-submit panel"><p class="small subtitle mb-3">Sau khi gửi, bạn nhận được mã chờ duyệt để theo dõi trong tủ đồ. Sản phẩm được đăng bán sau khi CoCo kiểm định và xác nhận.</p><button type="submit" class="btn btn-wine w-100">Gửi kiểm định và nhận mã chờ duyệt <svg class="icon" aria-hidden="true"><use href="/images/icons.svg#arrow-right" /></svg></button></div>
        </form>
    </div>
    <aside class="col-lg-4"><div class="panel listing-guide">
        <span class="eyebrow">CoCo đồng hành cùng bạn</span><h2 class="h4 mt-2 mb-4">Ký gửi thật đơn giản</h2>
        <ol class="listing-steps"><li><strong>Gửi thông tin món đồ</strong><p>Chụp ảnh thật và điền các thông tin cơ bản.</p></li><li><strong>Mang hoặc gửi đến CoCo</strong><p>Nhân viên kiểm tra sản phẩm và ghi nhận tình trạng thực tế.</p></li><li><strong>CoCo duyệt và đăng bán</strong><p>Món đồ có mã sản phẩm chính thức và xuất hiện trên sàn.</p></li></ol>
        <div class="divider"></div><p class="small subtitle mb-0"><svg class="icon" aria-hidden="true"><use href="/images/icons.svg#shield" /></svg> Bạn có thể theo dõi kết quả kiểm định trong tủ đồ và thông báo.</p>
    </div></aside>
</div>
