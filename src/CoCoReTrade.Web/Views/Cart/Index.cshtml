@model IReadOnlyList<ProductCard>
@{ ViewData["Title"] = "Giỏ hàng"; }
<div class="eyebrow mt-4">Chọn món đồ yêu thích</div>
<h1 class="page-title mt-1">Giỏ hàng</h1>
<p class="subtitle">Thêm vào giỏ không giữ sản phẩm. Mỗi món đồ là độc bản và được đặt riêng khi bạn xác nhận đơn hàng.</p>
@if (Model.Count == 0)
{
    <div class="empty-state mt-4"><div class="empty-icon">♡</div><h2 class="display-serif">Giỏ hàng đang trống</h2><a class="btn btn-wine mt-2" asp-controller="Shop" asp-action="Index">Khám phá sản phẩm</a></div>
}
else
{
    <div class="row g-3 mb-5">
        @foreach (var item in Model)
        {
            <div class="col-12"><article class="panel d-flex flex-column flex-sm-row gap-3 align-items-sm-center">
                <a asp-controller="Shop" asp-action="Details" asp-route-id="@item.Id">
                    @if (item.CoverImageId.HasValue) { <img src="/images/@item.CoverImageId" alt="@item.Name" class="cart-image" loading="lazy" /> }
                    else { <span class="product-placeholder cart-image">CoCo</span> }
                </a>
                <div class="flex-grow-1"><div class="eyebrow">@item.Sku · @item.Brand</div><h2 class="display-serif fs-4 mb-1"><a asp-controller="Shop" asp-action="Details" asp-route-id="@item.Id">@item.Name</a></h2><div class="subtitle">Size @item.Size · @item.ConditionPercent% độ mới</div><strong>@item.AskingPrice.ToString("N0")đ</strong></div>
                <div class="d-flex flex-sm-column gap-2"><a class="btn btn-wine" asp-controller="Checkout" asp-action="Index" asp-route-productId="@item.Id">Đặt mua</a><form asp-action="Remove" method="post"><input type="hidden" name="productId" value="@item.Id" /><button type="submit" class="btn btn-outline-wine w-100">Bỏ khỏi giỏ</button></form></div>
            </article></div>
        }
    </div>
}
