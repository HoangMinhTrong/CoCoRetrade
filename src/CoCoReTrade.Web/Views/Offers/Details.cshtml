@model OfferDto
@inject ShippingPolicy Shipping
@{ ViewData["Title"] = "Đề xuất giá " + Model.ProductSku; var me = User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
   var myTurn = (Model.Status == OfferStatus.PendingSeller && me == Model.SellerId) || (Model.Status == OfferStatus.PendingBuyer && me == Model.BuyerId);
   var canCounter = Model.CounterMinimumPrice.HasValue && Model.CounterMaximumPrice.HasValue; }
<div class="mt-4 mb-3"><a asp-action="Index">← Tất cả đề xuất giá</a></div>
<div class="row g-4 mb-5"><div class="col-lg-7"><div class="panel">
    <div class="d-flex justify-content-between align-items-start gap-2"><div><div class="eyebrow">@Model.ProductSku</div><h1 class="page-title mt-1 mb-1">@Model.ProductName</h1></div><span class="status-pill @Model.Status">@UiText.For(Model.Status)</span></div>
    <p class="subtitle">Giá niêm yết @Model.AskingPrice.ToString("N0") VNĐ</p>
    <div class="divider"></div><div class="spec-row"><span>Giá hiện tại</span><strong class="product-price">@Model.CurrentPrice.ToString("N0") VNĐ</strong></div>
    <div class="spec-row"><span>Hạn phản hồi / thanh toán</span><strong>@Model.ExpiresAtUtc.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</strong></div>
    <div class="spec-row"><span>Lượt gửi giá của người mua</span><strong>@Model.BuyerOffersUsed / 3</strong></div>
    @if (Model.Status == OfferStatus.Accepted)
    {
        <div class="alert alert-success mt-4">Giá @Model.AcceptedPrice?.ToString("N0") VNĐ chỉ dành cho người mua này trong 24 giờ. Nếu chọn nhận tại CoCo, món đồ sẽ được tạm giữ sau khi người mua chọn giờ lấy và xác nhận đơn hàng.</div>
        @if ((bool?)ViewBag.PreviewMode == true) { <a asp-controller="Preview" asp-action="Checkout" class="btn btn-wine w-100">Xem màn hình đặt hàng →</a> }
        else if (me == Model.BuyerId)
        {
            <p class="small mb-2">Chọn cách nhận hàng theo giá đã thỏa thuận:</p>
            <div class="d-grid d-sm-flex gap-2">
                @if (Shipping.CanPickup)
                { <a asp-controller="Checkout" asp-action="Index" asp-route-productId="@Model.ProductId" asp-route-offerId="@Model.Id" asp-route-fulfillment="Pickup" class="btn btn-wine flex-fill">Tới CoCo lấy trong 24 giờ</a> }
                else
                { <button type="button" class="btn btn-outline-wine flex-fill" disabled aria-describedby="pickupUnavailable">Tới CoCo lấy trong 24 giờ</button> }
                <a asp-controller="Checkout" asp-action="Index" asp-route-productId="@Model.ProductId" asp-route-offerId="@Model.Id" asp-route-fulfillment="Shipping" class="btn btn-outline-wine flex-fill">Giao hàng tận nơi</a>
            </div>
            @if (!Shipping.CanPickup) { <p id="pickupUnavailable" class="alert alert-warning mt-3">Chưa thể chọn nhận tại CoCo vì cửa hàng chưa cấu hình địa chỉ lấy hàng. Vui lòng chọn giao tận nơi hoặc thử lại sau.</p> }
            <p class="form-text mt-2">Nếu chọn lấy tại CoCo, hãy hẹn giờ và xác nhận đơn. CoCo sẽ tạm giữ món đồ, ẩn khỏi sàn cho đến giờ hẹn. Quá hạn chưa lấy và chưa thanh toán, đơn được hủy và món đồ mở bán lại theo giá niêm yết.</p>
        }
    }
    else if (myTurn)
    {
        <div class="alert alert-light border mt-4">Đến lượt bạn phản hồi. Giá đề xuất sẽ hết hạn sau 24 giờ.</div>
        <div class="d-flex flex-wrap gap-2">
            <form asp-action="Respond" asp-route-id="@Model.Id" method="post"><input type="hidden" name="action" value="Accept" /><button class="btn btn-wine" type="submit">Chấp nhận</button></form>
            <form asp-action="Respond" asp-route-id="@Model.Id" method="post"><input type="hidden" name="action" value="Decline" /><button class="btn btn-outline-danger" type="submit">Từ chối</button></form>
        </div>
        @if (canCounter)
        {
            <form asp-action="Respond" asp-route-id="@Model.Id" method="post" class="mt-3">
                <input type="hidden" name="action" value="Counter" />
                <label for="counterPrice" class="form-label">Đề xuất lại</label>
                <div class="input-group">
                    <input id="counterPrice" name="price" type="number" min="@Model.CounterMinimumPrice.GetValueOrDefault().ToString("0", System.Globalization.CultureInfo.InvariantCulture)" max="@Model.CounterMaximumPrice.GetValueOrDefault().ToString("0", System.Globalization.CultureInfo.InvariantCulture)" step="1" required class="form-control" placeholder="Nhập mức giá thỏa hiệp" />
                    <button class="btn btn-outline-wine" type="submit">Gửi giá mới</button>
                </div>
                <div class="form-text">Mức hợp lệ: từ <strong>@Model.CounterMinimumPrice.GetValueOrDefault().ToString("N0") VNĐ</strong> đến <strong>@Model.CounterMaximumPrice.GetValueOrDefault().ToString("N0") VNĐ</strong>. Giá niêm yết: @Model.AskingPrice.ToString("N0") VNĐ.</div>
            </form>
        }
        else if (me == Model.BuyerId && Model.BuyerOffersUsed >= 3)
        {
            <div class="alert alert-light border mt-3">Bạn đã dùng hết 3 lượt trả giá. Bạn vẫn có thể chấp nhận hoặc từ chối đề xuất hiện tại.</div>
        }
        else
        {
            <div class="alert alert-light border mt-3">Không còn khoảng giá hợp lệ để đề xuất lại. Bạn có thể chấp nhận hoặc từ chối mức giá hiện tại.</div>
        }
    }
    else if (Model.Status is OfferStatus.PendingSeller or OfferStatus.PendingBuyer)
    { <div class="alert alert-light border mt-4">Đang chờ đối phương phản hồi.</div> }
    else { <div class="alert alert-light border mt-4">Phiên đề xuất này đã kết thúc.</div> }
</div></div>
<div class="col-lg-5"><div class="panel"><h2 class="display-serif fs-4 mb-3">Lịch sử thương lượng</h2>
    <ol class="offer-timeline">@foreach (var e in Model.Events) { <li><div class="small text-muted">@e.CreatedAtUtc.ToLocalTime().ToString("dd/MM HH:mm") · @(e.ActorId == me ? "Bạn" : "Đối phương")</div><strong>@UiText.For(e.Action)</strong>@if (e.Price.HasValue) { <span class="ms-2">@e.Price.Value.ToString("N0") VNĐ</span> }</li> }</ol>
</div></div></div>
