@model IReadOnlyList<OfferDto>
@{ ViewData["Title"] = "Đề xuất giá"; var me = User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value; }
<div class="eyebrow mt-4">Giao dịch</div><h1 class="page-title mt-1">Đề xuất giá</h1>
<p class="subtitle">Theo dõi các mức giá bạn gửi và nhận. Mỗi lượt phản hồi có hiệu lực 24 giờ.</p>
@if (Model.Count == 0)
{
    <div class="empty-state mt-4"><div class="empty-icon">♡</div><h2 class="display-serif">Chưa có đề xuất giá</h2><p>Tìm món đồ đã kiểm định và gửi mức giá bạn mong muốn.</p><a asp-controller="Shop" asp-action="Index" class="btn btn-wine">Khám phá sản phẩm</a></div>
}
else
{
    <div class="row g-3 mt-2">
    @foreach (var offer in Model)
    {
        <div class="col-md-6"><a class="panel d-block h-100 offer-card" asp-action="Details" asp-route-id="@offer.Id">
            <div class="d-flex justify-content-between gap-2"><span class="eyebrow">@offer.ProductSku</span><span class="status-pill @offer.Status">@offer.Status</span></div>
            <h2 class="display-serif fs-4 mt-2 mb-1">@offer.ProductName</h2>
            <p class="subtitle small mb-2">@(offer.BuyerId == me ? "Bạn là người mua" : "Bạn là người bán") · Hạn @offer.ExpiresAtUtc.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</p>
            <div class="d-flex justify-content-between align-items-end"><strong class="product-price">@offer.CurrentPrice.ToString("N0")đ</strong><span>Chi tiết →</span></div>
        </a></div>
    }
    </div>
}
