@{ ViewData["Title"] = "Xem giao diện"; }
<div class="eyebrow mt-4">Bản xem thử</div>
<h1 class="page-title">Khám phá giao diện CoCo ReTrade</h1>
<p class="subtitle">Các màn hình bên dưới dùng dữ liệu minh họa. Khi cài SQL Server và tắt chế độ xem thử, ứng dụng sẽ dùng dữ liệu thật.</p>
<div class="row g-3 mt-3 mb-5">
    <div class="col-sm-6 col-lg-4"><a class="panel preview-link d-block h-100" asp-controller="Home" asp-action="Index"><span>01</span><h2>Trang chủ</h2><p>Banner, danh mục và sản phẩm mới.</p></a></div>
    <div class="col-sm-6 col-lg-4"><a class="panel preview-link d-block h-100" asp-controller="Shop" asp-action="Index"><span>02</span><h2>Khám phá</h2><p>Tìm kiếm và lọc danh sách sản phẩm.</p></a></div>
    <div class="col-sm-6 col-lg-4"><a class="panel preview-link d-block h-100" asp-controller="Shop" asp-action="Details" asp-route-id="00000000-0000-0000-0000-000000000001"><span>03</span><h2>Chi tiết sản phẩm</h2><p>Thông tin món đồ đã kiểm định.</p></a></div>
    <div class="col-sm-6 col-lg-4"><a class="panel preview-link d-block h-100" asp-action="MakeOffer"><span>04</span><h2>Đề xuất giá</h2><p>Form trả giá cho người mua.</p></a></div>
    <div class="col-sm-6 col-lg-4"><a class="panel preview-link d-block h-100" asp-action="Offer"><span>05</span><h2>Thương lượng</h2><p>Lịch sử trả giá và mức giá chốt.</p></a></div>
    <div class="col-sm-6 col-lg-4"><a class="panel preview-link d-block h-100" asp-action="Checkout"><span>06</span><h2>Đặt hàng</h2><p>Mẫu thông tin nhận hàng và tổng tiền.</p></a></div>
    <div class="col-sm-6 col-lg-4"><a class="panel preview-link d-block h-100" asp-controller="Account" asp-action="Login"><span>07</span><h2>Đăng nhập</h2><p>Xem form tài khoản.</p></a></div>
    <div class="col-sm-6 col-lg-4"><a class="panel preview-link d-block h-100" asp-controller="Account" asp-action="Register"><span>08</span><h2>Đăng ký</h2><p>Xem form tạo tài khoản.</p></a></div>
</div>
