@model IReadOnlyList<ProductCard>
@{ ViewData["Title"] = "Tủ đồ " + ViewBag.SellerName; var seller = (UserProfileDto?)ViewBag.SellerProfile; }
<div class="d-flex align-items-center gap-3 mt-4 mb-3">@if (seller?.HasAvatar == true) { <img class="seller-avatar" src="/avatars/@seller.Id" alt="Ảnh đại diện @seller.FullName" /> }<div><div class="eyebrow">Người bán CoCo</div><h1 class="page-title mt-1 mb-0">Tủ đồ @ViewBag.SellerName</h1><p class="subtitle mb-0">Điểm tín nhiệm @(seller?.TrustScore ?? 100)/100</p></div></div>
@if (User.Identity?.IsAuthenticated == true && ViewBag.SellerId != User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value)
{ <form asp-controller="Social" asp-action="Follow" method="post" class="mb-4"><input type="hidden" name="sellerId" value="@ViewBag.SellerId" /><input type="hidden" name="selected" value="@((bool)ViewBag.IsFollowing ? "false" : "true")" /><input type="hidden" name="returnUrl" value="@(Context.Request.Path + Context.Request.QueryString)" /><button type="submit" class="btn btn-outline-wine">@((bool)ViewBag.IsFollowing ? "Bỏ theo dõi" : "+ Theo dõi")</button></form> }
<partial name="_ProductGrid" model="Model" />
