@model LoginForm
@{ ViewData["Title"] = "Đăng nhập"; }
<div class="auth-shell">
    <aside class="auth-story">
        <span class="eyebrow">Chào mừng đến với CoCo</span>
        <h2>Một tủ đồ.<br />Nhiều câu chuyện mới.</h2>
        <p>Mua món đồ bạn yêu thích, gửi bán món ít dùng. Cùng CoCo tạo nên một vòng đời mới cho thời trang.</p>
        <div class="auth-benefit"><svg class="icon" aria-hidden="true"><use href="/images/icons.svg#shield" /></svg> Sản phẩm được kiểm định trực tiếp</div>
        <div class="auth-benefit"><svg class="icon" aria-hidden="true"><use href="/images/icons.svg#heart" /></svg> Lưu món yêu thích, theo dõi tủ đồ hợp gu</div>
        <a class="text-link mt-4" asp-controller="Shop" asp-action="Index">Khám phá CoCo trước <svg class="icon" aria-hidden="true"><use href="/images/icons.svg#arrow-right" /></svg></a>
    </aside>
    <div class="auth-form-panel">
        <span class="eyebrow">Rất vui được gặp lại bạn</span>
        <h1 class="page-title mt-2">Đăng nhập</h1>
        <p class="subtitle">Tiếp tục hành trình cùng tủ đồ của bạn.</p>
        <form asp-action="Login" method="post" class="mt-4">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3" role="alert"></div>
            <div class="mb-3"><label asp-for="Identifier" class="form-label"></label><input asp-for="Identifier" class="form-control" autocomplete="username" placeholder="Email hoặc số điện thoại của bạn" /><span asp-validation-for="Identifier" class="text-danger small"></span></div>
            <div class="mb-2"><label asp-for="Password" class="form-label"></label><input asp-for="Password" class="form-control" autocomplete="current-password" placeholder="Nhập mật khẩu" /><span asp-validation-for="Password" class="text-danger small"></span></div>
            <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 my-3"><label class="form-check mb-0"><input asp-for="RememberMe" class="form-check-input" /> Ghi nhớ đăng nhập</label><a asp-action="ForgotPassword" class="small fw-semibold">Quên mật khẩu?</a></div>
            <button class="btn btn-wine w-100" type="submit">Đăng nhập <svg class="icon" aria-hidden="true"><use href="/images/icons.svg#arrow-right" /></svg></button>
        </form>
        <p class="text-center mt-4 mb-3">Chưa có tài khoản? <a asp-action="Register" class="fw-semibold">Đăng ký ngay</a></p>
        <div class="auth-secondary"><span class="small text-muted">Tài khoản chưa kích hoạt?</span> <a asp-action="ResendActivation" class="small">Gửi lại mã</a></div>
    </div>
</div>
