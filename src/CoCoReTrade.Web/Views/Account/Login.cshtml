@model LoginForm
@{ ViewData["Title"] = "Đăng nhập"; }
<div class="auth-card panel"><div class="eyebrow">Chào mừng trở lại</div><h1 class="mt-2">Đăng nhập CoCo</h1><p class="subtitle">Mở tủ đồ và khám phá những món đồ đã kiểm định.</p>
<form asp-action="Login" method="post" class="mt-4"><div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
    <div class="mb-3"><label asp-for="Identifier" class="form-label"></label><input asp-for="Identifier" class="form-control" autocomplete="username" /><span asp-validation-for="Identifier" class="text-danger small"></span></div>
    <div class="mb-2"><label asp-for="Password" class="form-label"></label><input asp-for="Password" class="form-control" autocomplete="current-password" /><span asp-validation-for="Password" class="text-danger small"></span></div>
    <div class="d-flex justify-content-between align-items-center my-3"><label class="form-check"><input asp-for="RememberMe" class="form-check-input" /> Ghi nhớ đăng nhập</label><a asp-action="ForgotPassword" class="small">Quên mật khẩu?</a></div>
    <button class="btn btn-wine w-100" type="submit">Đăng nhập →</button>
</form><p class="text-center mt-4 mb-1">Chưa có tài khoản? <a asp-action="Register" class="fw-semibold">Đăng ký</a></p><p class="text-center mb-0"><a asp-action="ResendActivation">Gửi lại mã kích hoạt</a></p></div>
