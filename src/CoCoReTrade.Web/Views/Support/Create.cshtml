@{ ViewData["Title"] = "Gửi yêu cầu hỗ trợ"; }
<div class="mt-4 mb-3"><a asp-action="Index">← Trợ giúp CoCo</a></div><h1 class="page-title">Gửi yêu cầu hỗ trợ</h1>
<form asp-action="Create" method="post" class="panel mb-5" style="max-width:700px"><div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div><div class="mb-3"><label for="subject" class="form-label">Chủ đề</label><input id="subject" name="subject" class="form-control" minlength="5" maxlength="150" required value="@ViewBag.Subject" /></div><div class="mb-3"><label for="body" class="form-label">Nội dung</label><textarea id="body" name="body" class="form-control" rows="5" minlength="3" maxlength="2000" required>@ViewBag.Body</textarea></div><button type="submit" class="btn btn-wine">Gửi tới CoCo</button></form>
