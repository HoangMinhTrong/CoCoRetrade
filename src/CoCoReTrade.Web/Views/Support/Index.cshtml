@model IReadOnlyList<SupportTicketRow>
@{ ViewData["Title"] = "Trợ giúp CoCo"; }
<div class="page-heading"><div><span class="eyebrow">Luôn có CoCo đồng hành</span><h1 class="page-title">Bạn cần hỗ trợ gì?</h1><p class="subtitle mb-0">Hỏi về ký gửi, đơn hàng, trả giá hoặc ví. Nhân viên sẽ phản hồi ngay trong ứng dụng.</p></div><a class="btn btn-wine flex-shrink-0" asp-action="Create"><svg class="icon" aria-hidden="true"><use href="/images/icons.svg#plus" /></svg> Gửi yêu cầu hỗ trợ</a></div>
<div class="panel support-intro d-flex align-items-start gap-3 mb-4"><svg class="icon flex-shrink-0" aria-hidden="true"><use href="/images/icons.svg#message" /></svg><div><h2 class="h6 mb-1">Mô tả rõ để CoCo hỗ trợ bạn tốt hơn</h2><p class="small subtitle mb-0">Nếu câu hỏi liên quan đến một đơn hàng hoặc sản phẩm, hãy ghi kèm mã đơn hoặc mã sản phẩm trong nội dung.</p></div></div>
<div class="section-heading"><h2>Yêu cầu của bạn</h2><span class="small text-muted">@Model.Count yêu cầu</span></div>
@if (Model.Count == 0)
{
    <div class="empty-state"><div class="empty-icon"><svg class="icon" aria-hidden="true"><use href="/images/icons.svg#message" /></svg></div><h3>Bạn chưa có yêu cầu hỗ trợ</h3><p>Khi cần giúp đỡ, gửi yêu cầu để bắt đầu trò chuyện với nhân viên CoCo.</p><a class="btn btn-outline-wine mt-2" asp-controller="Home" asp-action="Terms">Xem quy định mua bán và ký gửi</a></div>
}
else
{
    <div class="d-grid gap-3">
        @foreach (var ticket in Model)
        {
            <a class="panel support-ticket-row d-flex justify-content-between align-items-center gap-3" asp-action="Details" asp-route-id="@ticket.Id"><div><h3 class="h6 mb-2">@ticket.Subject</h3><span class="small text-muted">Cập nhật @ticket.LastActivityAtUtc.ToLocalTime().ToString("dd/MM/yyyy · HH:mm")</span></div><div class="d-flex flex-wrap align-items-center justify-content-end gap-2"><span class="status-pill @(ticket.Status == SupportTicketStatus.Open ? "Active" : "")">@(ticket.Status == SupportTicketStatus.Open ? "Đang xử lý" : "Đã đóng")</span><svg class="icon" aria-hidden="true"><use href="/images/icons.svg#chevron-right" /></svg></div></a>
        }
    </div>
}
